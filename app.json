{
  "expo": {
    "name": "Zony",
    "slug": "zony",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zony",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "nelzony",
    "extra": {
      "eas": {
        "projectId": "655aca0e-ce2d-4cfe-aa67-7a22d07cac85"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nelzony.zony",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.295900317104-dk7n2cq2obdc9a2v37p1p6ih61pj9fha"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.295900317104-dk7n2cq2obdc9a2v37p1p6ih61pj9fha"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nelzony.zony",
      "adaptiveIcon": {
        "backgroundColor": "#8B1A1A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#8B1A1A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8B1A1A"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              },
              {
                "name": "AppCheckCore",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}